{
 "title": "Quark",
 "children": [
  {
   "title": "Overview",
   "lines": [
    "Two layers: ATMOS",
    "(strings, 89 WTs,",
    "FM) and MELODY (a",
    "synth + arp). Then",
    "FX, shimmer and",
    "reverb. Jog: Presets,",
    "Atmos pages, Melody",
    "pages, then Mix,",
    "Reverb and Play."
   ]
  },
  {
   "title": "Atmos",
   "lines": [
    "Type: 100 engines.",
    "Strings: Variation",
    "sweeps violin >",
    "cello > brass >",
    "organ > choir. WT:",
    "Variation scans the",
    "table. Chord WTs",
    "(Fifths, Minor 9,",
    "Major 9, Dom 11,",
    "Fourths): Variation",
    "stacks intervals.",
    "FM: brightness.",
    "Var Env: the mod",
    "env moves Variation."
   ]
  },
  {
   "title": "Atmos Filter",
   "lines": [
    "LP12 LP24 HP12",
    "BP12 BP24, Dual BP",
    "(2 bands), Notch,",
    "Comb+ / Comb- (Res",
    "= feedback), Morph",
    "(Res = LP>BP>HP).",
    "Vintage: each note",
    "drifts in pitch,",
    "cutoff, env speed",
    "and level."
   ]
  },
  {
   "title": "Atmos Drive",
   "lines": [
    "Drive + Position:",
    "Pre filter, Post",
    "filter or Amp (the",
    "whole chord, notes",
    "intermodulate).",
    "Tone darkens it.",
    "Detune: each chord",
    "note drifts apart.",
    "Bloom: how long",
    "the drift takes.",
    "Latch holds chords",
    "after release."
   ]
  },
  {
   "title": "Atmos Motion",
   "lines": [
    "Motion: an LFO on",
    "Variation, Pitch,",
    "Filter, Pan or Amp,",
    "or a pair: the LFO",
    "moves the first and",
    "LFO 2 the second.",
    "Motion = depth.",
    "LFO 2 Rate = x the",
    "main rate. LFO Mode:",
    "Global = one LFO,",
    "Spread = per voice,",
    "Retrig = per note."
   ]
  },
  {
   "title": "Drones",
   "lines": [
    "Ensemble type Deep",
    "= wide slow chorus.",
    "Atmos Drive page:",
    "Latch holds chords",
    "after release; the",
    "next chord replaces",
    "them. Try Detune +",
    "Bloom + Deep, LFO",
    "Mode Spread."
   ]
  },
  {
   "title": "Melody",
   "lines": [
    "Shape: Saw, Pulse,",
    "Saw+Pulse, Sync, or",
    "any wavetable. WT:",
    "Variation = Wave Pos",
    "(analog: PWM > trem",
    "> vib). Var Env moves",
    "it. Filter and Var",
    "Env decay faster",
    "than the amp: plucks.",
    "Velocity knob sets",
    "how much velocity",
    "scales both envs.",
    "Tune: osc 2 vs 1,",
    "+-50 ct detune, then",
    "+-24 st intervals."
   ]
  },
  {
   "title": "User Wavetables",
   "lines": [
    "Put WAV wavetables",
    "(Serum/Vital: 2048",
    "per frame, or one",
    "single cycle) in",
    "UserLibrary/Samples/",
    "Schwung/Wavetables.",
    "Reload Quark: they",
    "appear at the end of",
    "Atmos Type and Melody",
    "Shape (16 max)."
   ]
  },
  {
   "title": "Melody Space",
   "lines": [
    "Melody Filter page,",
    "row 2: Spread < 0:",
    "notes land at",
    "random; > 0: notes",
    "step through fixed",
    "spots (Poly: per",
    "voice). Delay: one",
    "knob, synced Time,",
    "band-passed echoes."
   ]
  },
  {
   "title": "Melody Arp",
   "lines": [
    "Source Atmos Chord:",
    "Melody arpeggiates",
    "what Atmos holds.",
    "Keys: keys sent to",
    "Melody. Latch holds",
    "the arp's chord; arp",
    "off, it holds Melody",
    "notes (2nd pad).",
    "Types: Up Down UpDn",
    "DnUp Rnd Order Chord",
    "Leap In/Out Pattern."
   ]
  },
  {
   "title": "Arp Variation",
   "lines": [
    "Pattern: 40 note",
    "orders (chord steps).",
    "Drop skips steps.",
    "Velocity: 0 = as",
    "played. Random vel,",
    "gate, octave, note.",
    "Loop > 0 repeats",
    "the variation."
   ]
  },
  {
   "title": "Effects",
   "lines": [
    "Mix & Effect: layer",
    "volumes and routes",
    "(All, Rev, Dry),",
    "then the Effect:",
    "type, Control,",
    "Control 2, Amount.",
    "Reverb page: decay,",
    "size, tone, amount,",
    "shimmer, Vintage."
   ]
  },
  {
   "title": "Play",
   "lines": [
    "Transpose: +-24",
    "semitones per layer.",
    "Key mode: Stack,",
    "Melody Low / High",
    "(split at Split",
    "Point), Atmos or",
    "Melody only. Mod",
    "wheel target.",
    "Vibrato + rate act",
    "on both layers."
   ]
  },
  {
   "title": "Atmos Layer",
   "lines": [
    "Samples on top of the",
    "Atmos Type (+). Type",
    "Off: the Layer is the",
    "whole sound, and",
    "Motion / Var Env on",
    "Variation move Blend.",
    "A, B: two sets; Blend",
    "fades A into B.",
    "Tune: +-50 ct detune,",
    "then semitones.",
    "Start skips the attack.",
    "Mode: Loop/Shot go",
    "through the filter,",
    "Air/Ping skip it;",
    "Shot/Ping play once.",
    "Era: Clean, 90s (half",
    "rate, aliased), Lo-Fi",
    "(quarter, 12-bit)."
   ]
  }
 ]
}
